TZ=Asia/Shanghai

# App
APP_ENV=dev
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-32-plus-char-secret
MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1

# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=kkgoj
MYSQL_USER=blog
MYSQL_PASSWORD=change-me-blog-db-password

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=blog-images
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MINIO_USE_SSL=false

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=blog
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# Kafka
ZOOKEEPER_IMAGE=bitnamilegacy/zookeeper:3.9
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_IMAGE=bitnamilegacy/kafka:3.7.0

# Elasticsearch + Kibana
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_TWEET_INDEX=tweets
ELASTICSEARCH_POST_INDEX=posts
ELASTICSEARCH_USER_INDEX=users

# Bootstrap super admin (optional, blog backend startup)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@kkg.local
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# Observability
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
