TZ=Asia/Shanghai

# App
APP_ENV=dev
SERVER_PORT=8080
WEB_PORT=3001
GATEWAY_PORT=80
MYSQL_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
API_BASE_SERVER=http://host.docker.internal:8080
NEXT_PUBLIC_API_BASE=/blog-api
OJ_API_BASE_SERVER=http://host.docker.internal:8080/api/v1/oj
NEXT_PUBLIC_OJ_API_BASE=/blog-api/api/v1/oj

# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=blog
MYSQL_USER=blog
MYSQL_PASSWORD=change-me-blog-db-password

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password

# MinIO
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET=blog-images
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000
MINIO_USE_SSL=false

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=blog
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_JUDGE_QUEUE=oj.judge

# OJ runtime in unified backend
OJ_RABBITMQ_ENABLED=true
BLOG_BASE_URL=http://host.docker.internal:8080
BLOG_INTERNAL_AUTH_TOKEN=dev-blog-internal-token
OJ_BLOG_AGENT_PASSWORD=dev-agent-password
OJ_AGENT_ENABLED=false
OJ_AGENT_API_KEY=
OJ_AGENT_BASE_URL=https://api.deepseek.com/v1
OJ_AGENT_MODEL=deepseek-chat
OJ_AGENT_MAX_ROUND=3
OJ_AGENT_TEMPERATURE=0.2

# Judge sandbox
JUDGE_SANDBOX_TYPE=remote
JUDGE_SANDBOX_URL_INTERNAL=http://oj-sandbox:8082/executeCode
JUDGE_SANDBOX_URL_HOST=http://host.docker.internal:8082/executeCode
JUDGE_AUTH_SECRET=secretKey
SANDBOX_PORT=8082
SANDBOX_ADDR=:8082
SANDBOX_AUTH_SECRET=secretKey
SANDBOX_GO_MODE=container
SANDBOX_RUNNER_IMAGE=golang:1.23-bookworm
SANDBOX_RUNNER_TIMEOUT_SEC=12
SANDBOX_RUNNER_CPUS=1
SANDBOX_RUNNER_MEMORY=256m
SANDBOX_RUNNER_PIDS=64
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_WORKDIR=/private/tmp/kkg-sandbox

# Kafka
ZOOKEEPER_IMAGE=bitnamilegacy/zookeeper:3.9
ZOOKEEPER_PORT=2181
KAFKA_PORT=9092
KAFKA_IMAGE=bitnamilegacy/kafka:3.7.0

# Elasticsearch + Kibana
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_TWEET_INDEX=tweets
ELASTICSEARCH_POST_INDEX=posts
ELASTICSEARCH_USER_INDEX=users

# Bootstrap super admin (optional, blog backend startup)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@kkg.local
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# Observability
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
